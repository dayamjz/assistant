# Build output. The bare binary is anchored to the repository root: an
# unanchored "assistant" matches any path component of that name, which is the
# name of the binary's own source directory.
/bin/
/dist/
/assistant

# Go
*.test
*.out
/coverage.out

# Local operational state, never tracked
.no-mistakes/
.lavish/

# Editor and OS
.DS_Store
*.swp
.idea/
.vscode/
