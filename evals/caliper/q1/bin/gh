#!/usr/bin/env python3
"""PATH stand-in for `gh` used by Caliper Q1 gated attempts.

Mirrors the shapes `internal/forge` reads from real `gh` (see
`internal/forge/forgetest` and the consent tests): repo confirmation, empty
then populated PR list, create URL, open/mergeable view, and an empty check
rollup under `no_ci`. State lives under `$HOME/.caliper-q1-gh/` so each
Caliper attempt's temporary home is isolated.
"""
from __future__ import annotations

import json
import os
import pathlib
import sys

REPO = "dayamjz/caliper-q1"
PR_NUMBER = 9
PR_URL = f"https://github.com/{REPO}/pull/{PR_NUMBER}"
STATE = pathlib.Path(os.environ.get("HOME", "/tmp")) / ".caliper-q1-gh" / "state.json"


def load() -> dict:
    if STATE.is_file():
        return json.loads(STATE.read_text())
    return {"created": False, "head": "feature/unlimited", "base": "main", "oid": ""}


def save(state: dict) -> None:
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(state))


def json_flag(args: list[str]) -> str:
    for a in args:
        if a.startswith("--json="):
            return a[len("--json=") :]
        if a == "--json" and args.index(a) + 1 < len(args):
            return args[args.index(a) + 1]
    return ""


def flag(args: list[str], name: str) -> str:
    prefix = f"--{name}="
    for a in args:
        if a.startswith(prefix):
            return a[len(prefix) :]
    return ""


def main(argv: list[str]) -> int:
    args = argv[1:]
    state = load()
    if len(args) >= 2 and args[0] == "repo" and args[1] == "view":
        fields = json_flag(args)
        if "MergeAllowed" in fields:
            print(json.dumps({
                "mergeCommitAllowed": True,
                "squashMergeAllowed": True,
                "rebaseMergeAllowed": True,
            }))
            return 0
        print(json.dumps({"nameWithOwner": REPO}))
        return 0
    if len(args) >= 2 and args[0] == "pr" and args[1] == "list":
        if state["created"]:
            print(json.dumps([{"number": PR_NUMBER}]))
        else:
            print("[]")
        return 0
    if len(args) >= 2 and args[0] == "pr" and args[1] == "create":
        state["created"] = True
        state["head"] = flag(args, "head") or state["head"]
        state["base"] = flag(args, "base") or state["base"]
        save(state)
        print(PR_URL)
        return 0
    if len(args) >= 2 and args[0] == "pr" and args[1] == "view":
        fields = json_flag(args)
        if "statusCheckRollup" in fields:
            print(json.dumps({"headRefOid": state.get("oid", ""), "statusCheckRollup": []}))
            return 0
        print(json.dumps({
            "baseRefName": state["base"],
            "headRefName": state["head"].split(":")[-1],
            "headRefOid": state.get("oid", "0" * 40),
            "isDraft": False,
            "mergeable": "MERGEABLE",
            "number": PR_NUMBER,
            "state": "OPEN",
            "title": "caliper-q1",
            "url": PR_URL,
        }))
        return 0
    if len(args) >= 2 and args[0] == "pr" and args[1] == "edit":
        print(json.dumps({
            "baseRefName": state["base"],
            "headRefName": state["head"].split(":")[-1],
            "headRefOid": state.get("oid", "0" * 40),
            "isDraft": False,
            "mergeable": "MERGEABLE",
            "number": PR_NUMBER,
            "state": "OPEN",
            "title": "caliper-q1",
            "url": PR_URL,
        }))
        return 0
    sys.stderr.write(f"caliper-q1 gh stand-in: unhandled: {' '.join(args)}\n")
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
