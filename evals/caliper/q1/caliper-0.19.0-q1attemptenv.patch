caliper-eval 0.19.0 sdist, patched for Q1 (#936): every step gets the attempt's key in the
saved result as CALIPER_TASK_ID and CALIPER_ATTEMPT; version 0.19.0+q1attemptenv.
install-caliper.sh applies it; README "As run" owns why.

--- a/caliper/runner.py
+++ b/caliper/runner.py
@@ -454,3 +454,3 @@
     record: AttemptRecord | None = None
-    with AttemptWorkdir(env.spec_path.parent) as workdir:
+    with AttemptWorkdir(env.spec_path.parent, task.id, attempt) as workdir:
         try:
--- a/caliper/workdir.py
+++ b/caliper/workdir.py
@@ -32,2 +32,5 @@
 SPEC_DIR_ENV = "CALIPER_SPEC_DIR"
+#: The attempt's task id and attempt number: its key in the saved result.
+TASK_ID_ENV = "CALIPER_TASK_ID"
+ATTEMPT_ENV = "CALIPER_ATTEMPT"
 
@@ -82,3 +85,8 @@
 
-    def __init__(self, spec_dir: str | Path) -> None:
+    def __init__(
+        self,
+        spec_dir: str | Path,
+        task_id: str | None = None,
+        attempt: int | None = None,
+    ) -> None:
         # Absolute, because every step runs in the workdir: a relative spec dir
@@ -86,2 +94,7 @@
         self.spec_dir = str(Path(spec_dir).resolve())
+        self.key = (
+            {}
+            if task_id is None or attempt is None
+            else {TASK_ID_ENV: task_id, ATTEMPT_ENV: str(attempt)}
+        )
         self._root: str | None = None
@@ -150,2 +163,3 @@
             cancel.PROCESS_TAG: process_tag,
+            **self.key,
         }
