@@ -48,2 +48,13 @@
 
+def test_steps_see_the_attempt_key_when_given(tmp_path) -> None:
+    script = (
+        "import os\n"
+        "assert os.environ['CALIPER_TASK_ID'] == 'task-007'\n"
+        "assert os.environ['CALIPER_ATTEMPT'] == '3'\n"
+    )
+    with AttemptWorkdir(tmp_path, "task-007", 3) as workdir:
+        step = workdir.run_python("assert", script)
+    assert step.ok, step.output
